# connection_limit=1 pins this to a single physical connection: SQLite
# doesn't benefit from a real pool, and `PRAGMA busy_timeout` (set in
# src/lib/db.ts) is per-connection, so a pool would leave some connections
# without it applied.
DATABASE_URL="file:./dev.db?connection_limit=1"

# How often the worker looks for new competitions vs. attempts entries.
DISCOVERY_INTERVAL_MINUTES=30
ENTRY_INTERVAL_MINUTES=10

# How many competitions an entry pass attempts at once. Real parallelism
# only happens across different hosts — same-host attempts always
# serialize (see withHostThrottle in src/lib/net/politeness.ts), so this
# mainly speeds up a backlog spread across many sponsor domains. Keep it
# modest on a Raspberry Pi — each one is a real headless Chromium tab.
ENTRY_CONCURRENCY=2

# Minimum gap between two requests to the same host, across discovery and
# entries — keeps this from hammering any one site.
MIN_DELAY_PER_HOST_MS=4000

# How often the worker runs the other passes.
PLATFORM_DISCOVERY_INTERVAL_MINUTES=60
NEWSLETTER_INTERVAL_MINUTES=180
PRUNE_INTERVAL_MINUTES=360

# Where to send a "possible win" alert. Either or both may be set; a win
# is archived once at least one succeeds. Without either, win emails are
# left in the inbox rather than archived — the mail pass will not file
# away something nobody has been told about.
#   ntfy:    https://ntfy.sh/some-topic-name-only-you-know
#   generic: any URL that accepts a JSON POST (Slack/Discord/webhook)
# NOTIFY_WEBHOOK=
#
# Emails the address through the same Gmail account below (needs
# GOOGLE_REFRESH_TOKEN to include the gmail.send scope — re-run
# `npm run gmail:auth` if that token predates this setting).
# WIN_NOTIFY_EMAIL=

# Gmail triage — optional. Leave unset to skip it entirely. See README for
# how to create the OAuth client and run `npm run gmail:auth`.
#
# NOTE: this now needs the gmail.modify scope (it archives messages once
# they're handled), so a token issued for the old read-only scope must be
# regenerated with `npm run gmail:auth`.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# MAIL_SCAN_INTERVAL_MINUTES=60
# MAIL_SCAN_MAX=50
# Which messages the pass considers. The default is the whole recent inbox,
# because triage now sorts wins from competition leads from everything else.
# MAIL_SCAN_QUERY=in:inbox newer_than:30d

# Dashboard port.
PORT=3100
