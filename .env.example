DATABASE_URL="file:./dev.db"

# How often the worker looks for new competitions vs. attempts entries.
DISCOVERY_INTERVAL_MINUTES=30
ENTRY_INTERVAL_MINUTES=10

# How many headless Chromium pages run at once during an entry pass.
# Keep this low on a Raspberry Pi — each page is a real browser tab.
ENTRY_CONCURRENCY=2

# Minimum gap between two requests to the same host, across discovery and
# entries — keeps this from hammering any one site.
MIN_DELAY_PER_HOST_MS=4000

# How often the worker runs the other passes.
PLATFORM_DISCOVERY_INTERVAL_MINUTES=60
NEWSLETTER_INTERVAL_MINUTES=180
PRUNE_INTERVAL_MINUTES=360

# Where to send a "possible win" alert. Without this, win emails are left
# in the inbox rather than archived — the mail pass will not file away
# something nobody has been told about.
#   ntfy:    https://ntfy.sh/some-topic-name-only-you-know
#   generic: any URL that accepts a JSON POST (Slack/Discord/webhook)
# NOTIFY_WEBHOOK=

# Gmail triage — optional. Leave unset to skip it entirely. See README for
# how to create the OAuth client and run `npm run gmail:auth`.
#
# NOTE: this now needs the gmail.modify scope (it archives messages once
# they're handled), so a token issued for the old read-only scope must be
# regenerated with `npm run gmail:auth`.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# MAIL_SCAN_INTERVAL_MINUTES=60
# MAIL_SCAN_MAX=50
# Which messages the pass considers. The default is the whole recent inbox,
# because triage now sorts wins from competition leads from everything else.
# MAIL_SCAN_QUERY=in:inbox newer_than:30d

# Dashboard port.
PORT=3100
