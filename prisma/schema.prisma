// Single-user entry assistant: one Profile drives every automated entry.
// Deliberately no support for multiple identities per competition —
// that crosses from "assistant" into sweepstakes fraud.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Profile {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  addressLine1 String?
  addressLine2 String?
  city        String?
  region      String?
  postalCode  String?
  country     String?
  dateOfBirth DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// SQLite has no native enum type, so status fields below are plain strings
// constrained by the TypeScript union types in src/lib/automation/types.ts
// and src/lib/status.ts — validate against those, not free-form values.

model FeedSource {
  id            String   @id @default(cuid())
  name          String
  url           String   @unique // feed URL, or the listing page URL for kind = "html"
  kind          String   @default("rss") // "rss" | "html"
  scraperKey    String?  // which scraper in src/lib/discovery/scrapers handles this, when kind = "html"
  enabled       Boolean  @default(true)
  lastFetchedAt DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  competitions  Competition[]
}

model Competition {
  id              String   @id @default(cuid())
  name            String
  url             String   @unique // resolved off-site entry form URL
  adapterKey      String   @default("generic") // which adapter in src/lib/automation/adapters handles this site; "generic" = heuristic form-fill
  opensAt         DateTime?
  closesAt        DateTime?
  maxEntries      Int      @default(1) // entries allowed per person, per the competition's own rules
  status          String   @default("PENDING") // PENDING | ENTERED | SKIPPED | FAILED | CLOSED
  notes           String?
  feedSourceId    String?
  feedSource      FeedSource? @relation(fields: [feedSourceId], references: [id])
  sourceListingUrl String? // the discovery listing page this was resolved from, for debugging
  createdAt       DateTime @default(now())
  entries         Entry[]
}

model Entry {
  id             String   @id @default(cuid())
  competitionId  String
  competition    Competition @relation(fields: [competitionId], references: [id])
  status         String   // SUCCESS | FAILED | SKIPPED_ALREADY_ENTERED | SKIPPED_RULES
  message        String?
  attemptedAt    DateTime @default(now())
}

// Read-only surface of possible "you've won" emails, for a human to check —
// the mail scanner never replies, deletes, marks read, or clicks anything.
model PotentialWin {
  id              String   @id @default(cuid())
  gmailMessageId  String   @unique
  from            String
  subject         String
  snippet         String
  receivedAt      DateTime
  reviewed        Boolean  @default(false)
  createdAt       DateTime @default(now())
}
