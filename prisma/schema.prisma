// Single-user entry assistant: one Profile drives every automated entry.
// Deliberately no support for multiple identities per competition —
// that crosses from "assistant" into sweepstakes fraud.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Profile {
  id          String   @id @default(cuid())
  title       String? // Mr/Mrs/Ms/Miss/Dr/Mx/... — some entry forms require this, most don't
  firstName   String
  lastName    String
  email       String
  phone       String?
  addressLine1 String?
  addressLine2 String?
  city        String?
  region      String?
  postalCode  String?
  country     String?
  dateOfBirth DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// SQLite has no native enum type, so status fields below are plain strings
// constrained by the TypeScript union types in src/lib/automation/types.ts
// and src/lib/status.ts — validate against those, not free-form values.

model FeedSource {
  id            String   @id @default(cuid())
  name          String
  url           String   @unique // feed URL, or the listing page URL for kind = "html"
  kind          String   @default("rss") // "rss" | "html"
  scraperKey    String?  // which scraper in src/lib/discovery/scrapers handles this, when kind = "html"
  enabled       Boolean  @default(true)
  lastFetchedAt DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  competitions  Competition[]
}

model Competition {
  id          String   @id @default(cuid())
  name        String
  url         String   @unique // for feed-discovered rows, the resolved off-site entry form URL
  // Which adapter in src/lib/automation/adapters handles this site.
  // Defaults to "generic" (heuristic form-fill) because the feed-discovery
  // pipeline creates rows before anyone has written a site-specific
  // adapter; every other code path sets this explicitly.
  adapterKey  String   @default("generic")
  opensAt     DateTime?
  closesAt    DateTime?
  maxEntries  Int      @default(1) // entries allowed per person, per the competition's own rules
  // For repeatable draws (a daily prize draw, say): the minimum hours
  // between two counted entry attempts. Null means "no cadence of its
  // own" — see src/lib/scheduler/schedule.ts, which falls back to 24h for
  // any competition whose maxEntries is above 1.
  entryIntervalHours Int?
  status      String   @default("PENDING") // PENDING | ENTERED | SKIPPED | FAILED | CLOSED
  notes       String?
  // Set only for sites that require a real account to enter — JSON string,
  // e.g. {"username","password"}. Same pattern as NewsletterSource.credentials.
  credentials String?
  // Provenance, set only for rows the feed-discovery pipeline created.
  feedSourceId     String?
  feedSource       FeedSource? @relation(fields: [feedSourceId], references: [id], onDelete: SetNull)
  sourceListingUrl String? // the discovery listing page this was resolved from, for debugging
  createdAt   DateTime @default(now())
  entries     Entry[]
}

model Entry {
  id             String   @id @default(cuid())
  competitionId  String
  competition    Competition @relation(fields: [competitionId], references: [id])
  runId          String?
  run            Run?     @relation(fields: [runId], references: [id])
  status         String   // SUCCESS | FAILED | SKIPPED_ALREADY_ENTERED | SKIPPED_RULES
  message        String?
  attemptedAt    DateTime @default(now())
}

// One row per `run:entries` invocation, so a scheduled/unattended run can be
// reviewed after the fact instead of only living in stdout.
model Run {
  id             String    @id @default(cuid())
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  status         String    @default("RUNNING") // RUNNING | COMPLETED | FAILED
  dryRun         Boolean   @default(false)
  candidateCount Int?
  errorMessage   String?
  logLines       LogLine[]
  entries        Entry[]
  subscriptionAttempts SubscriptionAttempt[]
}

model LogLine {
  id                 String   @id @default(cuid())
  runId              String
  run                Run      @relation(fields: [runId], references: [id])
  level              String   // INFO | WARN | ERROR
  message            String
  competitionId      String?
  newsletterSourceId String?
  createdAt          DateTime @default(now())
}

// A first-party newsletter from an organisation we're also tracking
// competitions from — signed up deliberately at the user's explicit
// request, not ticked incidentally on a competition entry form (that
// stays opt-out by default, see the adapter docs). Scoped to the
// organisation's own newsletter, not broader "share my data with our
// partners" consent.
model NewsletterSource {
  id         String                @id @default(cuid())
  name       String
  url        String                @unique
  adapterKey String                // which adapter in src/lib/newsletters/adapters handles this site
  status      String                @default("PENDING") // PENDING | SUBSCRIBED | FAILED | SKIPPED
  notes       String?
  // Set only for sites that require a real account (not just an email-list
  // opt-in) to receive their newsletter — JSON string, e.g. {"username",
  // "password"}. Generated locally, stored so the account is actually
  // usable later; never logged in plaintext.
  credentials String?
  createdAt   DateTime              @default(now())
  attempts   SubscriptionAttempt[]
}

model SubscriptionAttempt {
  id                 String           @id @default(cuid())
  newsletterSourceId String
  newsletterSource   NewsletterSource @relation(fields: [newsletterSourceId], references: [id])
  runId              String?
  run                Run?             @relation(fields: [runId], references: [id])
  status             String           // SUCCESS | FAILED
  message            String?
  attemptedAt        DateTime         @default(now())
}

// Possible "you've won" emails, surfaced for a human to check. The mail
// scanner never replies, deletes, or forwards — the only mailbox change it
// makes is archiving a message once it has been fully handled, and for a
// win that means only after the win notification actually went out.
model PotentialWin {
  id              String   @id @default(cuid())
  gmailMessageId  String   @unique
  from            String
  subject         String
  snippet         String
  receivedAt      DateTime
  reviewed        Boolean  @default(false)
  // When the configured notification webhook accepted this win. Null means
  // nobody has been told yet, which is what stops it being archived.
  notifiedAt      DateTime?
  createdAt       DateTime @default(now())
}

// One row per message the mail triage has looked at, so a message is never
// handled twice and so "why is this still in my inbox?" has an answer.
model ProcessedEmail {
  id             String   @id @default(cuid())
  gmailMessageId String   @unique
  from           String
  subject        String
  receivedAt     DateTime
  // WIN | LEADS | NOTHING — see src/lib/gmail/triage.ts
  category       String
  // How many competition links this email contributed, for LEADS.
  linksFound     Int      @default(0)
  linksRegistered Int     @default(0)
  // Set once the message was actually archived (INBOX label removed).
  archivedAt     DateTime?
  // Why it hasn't been archived yet, when it hasn't.
  heldReason     String?
  processedAt    DateTime @default(now())
}
